# This repository contains only the rebuilt site. The legacy site remains local.
/*
!/.gitignore
!/README.md
!/Makefile
!/requirements.txt
!/frontend/
!/tools/
!/migration/
!/dist/

/tools/*
!/tools/build-site.py
!/tools/dev-server.py
!/tools/test_built_site.py
!/tools/test_refined_data.py

/migration/*
!/migration/front-data/
!/migration/front-assets/
!/migration/rapports/
/migration/rapports/*
!/migration/rapports/site-build.json

# Invalid or incorrectly attributed excerpts, not published by the site.
/migration/front-assets/extraits/les-affiches/01-documents-extrait-lesaffiches.pdf
/migration/front-assets/extraits/mon-monde-et-moi/01-documents-mon-monde-et-moi-extrait.pdf
