{
  "version": 4,
  "statuts": [
    "brouillon",
    "publie",
    "archive"
  ],
  "champs": {
    "livre": {
      "ordre": {
        "type": "integer",
        "minimum": 0
      },
      "miseEnAvantAccueil": {
        "type": "boolean"
      },
      "aDecouvrir": {
        "type": "array",
        "relation": "livre"
      },
      "paypalHostedButtonId": {
        "type": "string",
        "obligatoireSiDisponible": true,
        "pattern": "^[A-Z0-9]{13}$"
      },
      "couvertureAlt": {
        "type": "string",
        "fallback": "Couverture de {titre}"
      }
    },
    "sectionDePage": {
      "boutonsPaypal": {
        "type": "array",
        "champs": {
          "libelle": "string",
          "hostedButtonId": {
            "type": "string",
            "pattern": "^[A-Z0-9]{13}$"
          }
        }
      }
    },
    "mediaAvecAlt": {
      "type": "object",
      "champs": {
        "image": "content/media/...",
        "alt": "string"
      }
    },
    "seo": {
      "type": "object",
      "champs": [
        "titre",
        "description",
        "image"
      ]
    },
    "apparence": {
      "description": "Réglage content/reglages/apparence.json : couleurs et polices du thème. Contrat complet : docs/CONTRAT-APPARENCE.md",
      "clesExactes": true,
      "champs": {
        "couleurFond": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurSurface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurTexte": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurTexteSecondaire": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurPrincipale": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurPrincipaleFoncee": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurSecondaire": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurLiens": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "couleurBoutons": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "policeTitres": {
          "type": "string",
          "enum": [
            "serif-classique",
            "serif-livre",
            "sans-serif-moderne",
            "sans-serif-humaniste"
          ]
        },
        "policeTexte": {
          "type": "string",
          "enum": [
            "serif-classique",
            "serif-livre",
            "sans-serif-moderne",
            "sans-serif-humaniste"
          ]
        }
      }
    }
  }
}
